# Essenplan auf dem Webserver – wird von manitu/paket.py zu .htaccess.

# Ordnerinhalt nie auflisten
Options -Indexes

# Nur über HTTPS; die Anmeldung (Cookie, gemeinsam mit der Schwester-App) macht die App selbst
# (anmeldung.py). Über http:// gibt es gar keinen Zugriff.
<If "%{HTTPS} != 'on'">
    Require all denied
</If>

# Code und Daten nie direkt ausliefern (zusätzlich zur Umleitung unten)
<FilesMatch "(^\.|\.(py|md|json|txt|lock|vorlage)$)">
    Require all denied
</FilesMatch>

# Alle Anfragen gehen an essenplan.cgi (PATH_INFO = /api/...)
DirectoryIndex essenplan.cgi
RewriteEngine On
RewriteRule ^essenplan\.cgi - [L]
RewriteRule ^(.*)$ essenplan.cgi/$1 [L]
